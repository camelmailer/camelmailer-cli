{
  "name": "camelmailer-cli",
  "version": "0.1.0",
  "description": "Command-line interface for CamelMailer — send and inspect transactional email from your terminal",
  "keywords": [
    "camelmailer",
    "email",
    "transactional",
    "cli",
    "smtp",
    "self-hosted"
  ],
  "homepage": "https://camelmailer.com",
  "bugs": {
    "url": "https://github.com/camelmailer/camelmailer-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/camelmailer/camelmailer-cli.git"
  },
  "license": "MIT",
  "author": "CamelMailer contributors",
  "type": "module",
  "bin": {
    "camelmailer": "./dist/cli.js"
  },
  "files": [
    "dist",
    "scripts"
  ],
  "scripts": {
    "build": "tsup",
    "prepare": "tsup",
    "postinstall": "node scripts/ensure-camelmailer-dist.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "camelmailer": "github:camelmailer/camelmailer-node",
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "eslint": "^9.17.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
